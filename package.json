{
  "name": "aula",
  "version": "0.2.0",
  "private": true,
  "description": "A local-first agent harness for learning: probe, plan, teach and practice, with a persistent knowledge graph and an Obsidian vault.",
  "license": "MIT",
  "author": "Nouh Khouyi",
  "homepage": "https://github.com/NouhKhouyi/aula",
  "repository": {
    "type": "git",
    "url": "https://github.com/NouhKhouyi/aula.git"
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "showcase": "tsx scripts/showcase.ts",
    "site:build": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.2.0",
    "next": "^16.4.3",
    "openai": "^7.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
